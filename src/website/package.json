{
  "name": "ai-product-builder-website",
  "version": "0.1.0",
  "private": true,
  "description": "Static site that presents the ai-product-builder library \u2014 reads the repo's markdown at build time.",
  "scripts": {
    "cache:clean": "rm -rf node_modules .next out && echo 'Caches cleared. Run pnpm install to reinstall.'",
    "start:dev": "portless run --lan -- next dev",
    "start:dev:raw": "next dev --port 3006",
    "build": "next build",
    "start": "next start",
    "types": "tsc --noEmit",
    "lint": "eslint .",
    "arch:check": "node scripts/tools/audit-domain-graph.mjs",
    "type:check": "node scripts/tools/audit-type-scale.mjs",
    "ci:quality": "pnpm types && pnpm lint && pnpm arch:check --strict && pnpm type:check --strict && pnpm build"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "next": "16.3.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "22.15.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "eslint": "^9.39.5",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.69.0"
  },
  "packageManager": "pnpm@10.22.0"
}
