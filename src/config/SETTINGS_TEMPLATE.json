{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(«PKG_MGR»:*)",
      "Bash(«RUNTIME_CLI»:*)",
      "Bash(«DB_CLI»:*)",
      "Bash(npx:*)",
      "Bash(nvm:*)",
      "Bash(corepack:*)",
      "Bash(. ~/.nvm/nvm.sh:*)",
      "Bash(. \"$NVM_DIR/nvm.sh\":*)",
      "Bash(source:*)",
      "Bash(export:*)",
      "Bash(bash -c:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(du:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(xargs:*)",
      "Bash(printf:*)",
      "Bash(echo:*)",
      "Bash(test:*)",
      "Bash(chmod:*)",
      "Bash(open:*)",
      "Bash(curl:*)",
      "Bash(ps:*)",
      "Bash(lsof:*)",
      "Bash(pgrep:*)",
      "Bash(pkill:*)",
      "Bash(kill:*)",
      "Bash(python3:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:«DOCS_DOMAIN»)"
    ],
    "deny": [
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(«DEPLOY_CLI» env add:*)",
      "Bash(«DEPLOY_CLI» env rm:*)",
      "Bash(«DEPLOY_CLI» env pull:*)",
      "Bash(«DEPLOY_CLI» deploy:*)",
      "Bash(«DEPLOY_CLI» promote:*)",
      "Bash(«DEPLOY_CLI» rollback:*)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.preview)",
      "Edit(**/.env.test)",
      "Edit(**/.env.*.local)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.development)",
      "Write(**/.env.production)",
      "Write(**/.env.staging)",
      "Write(**/.env.preview)",
      "Write(**/.env.test)",
      "Write(**/.env.*.local)"
    ]
  }
}
