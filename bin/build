#!/usr/bin/env bash
#
# Flatten the src/ tree into the layout consumer repos vendor.
#
#   src/managers/MANAGER_X.md  ─┐
#   src/runbooks/RUNBOOK_X.md  ─┼─▶  <out>/MANAGER_X.md, <out>/RUNBOOK_X.md   (flat)
#   src/meta/PLACEHOLDERS.md   ─┤
#   README.md                  ─┘
#   src/commands/foo.md        ───▶  <out>/commands/foo.md
#
# The flat output is the contract: every doc cross-references its siblings by
# bare filename (`RUNBOOK_E2E.md`), which only resolves once flattened.
#
# Usage:
#   bin/build                       # build into dist/
#   bin/build --out ../app/docs/ai-product-builder
#   bin/build --check               # build, then verify cross-links resolve
#
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out="$root/dist"
check=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --out)   out="$2"; shift 2 ;;
    --check) check=1; shift ;;
    -h|--help) sed -n '2,18p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

# Resolve --out to an absolute path before we start deleting anything.
mkdir -p "$out"
out="$(cd "$out" && pwd)"

if [[ "$out" == "$root" ]]; then
  echo "refusing to build into the repo root" >&2
  exit 1
fi

# --- deployed-name mapping -------------------------------------------------
# A RUNBOOK is a *template you fill*, so the prefix is a shipping-crate label:
# it names the crate, not the thing inside. It is stripped on deploy —
# RUNBOOK_METRICS.md ships as METRICS.md — which is what consumer repos
# actually do by hand, and what the docs' own cross-links already assume.
#
# A MANAGER is a *playbook you run*. It keeps its prefix: it stays recognisably
# a library artifact rather than a doc the repo owns, and dropping it would
# collide with the RUNBOOK of the same name (MANAGER_DECISION_LOG /
# RUNBOOK_DECISION_LOG both want DECISION_LOG.md).
deployed_name() {
  case "$1" in
    RUNBOOK_*) echo "${1#RUNBOOK_}" ;;
    *)         echo "$1" ;;
  esac
}

# --- collision guard -------------------------------------------------------
# Flattening several dirs into one is only safe while *deployed* names are
# unique — so this must run on the post-strip names, not the source ones.
dupes="$(for f in "$root/src/managers/"*.md "$root/src/runbooks/"*.md "$root/src/meta/"*.md; do
           deployed_name "$(basename "$f")"
         done | sort | uniq -d)"
if [[ -n "$dupes" ]]; then
  echo "deployed-name collision — these resolve to the same output file:" >&2
  echo "$dupes" >&2
  exit 1
fi

# --- build -----------------------------------------------------------------
rm -rf "$out"
mkdir -p "$out/commands"

for dir in managers runbooks meta; do
  for f in "$root/src/$dir/"*.md; do
    cp "$f" "$out/$(deployed_name "$(basename "$f")")"
  done
done
cp "$root/src/commands/"*.md "$out/commands/"

# README / CATALOG / CONTRIBUTING are about *this repo* — they link into src/, which does not
# exist downstream. A consumer's docs/ gets the library, not our front page.

# Layers that install into .claude/ rather than docs/ — copied through verbatim.
for dir in agents scripts config; do
  [[ -d "$root/src/$dir" ]] || continue
  mkdir -p "$out/$dir"
  cp -R "$root/src/$dir/." "$out/$dir/"
done

# --- skills: one source, two outputs -----------------------------------------
# A skill source is both a doc a human can read and an artifact the agent can
# fire. So it ships twice:
#
#   OUT/SKILL_X.md              flat, alongside the other docs — sibling links resolve
#   OUT/skills/<name>/SKILL.md  drop into .claude/skills/ — frontmatter hoisted
#
# The YAML lives in a `## Frontmatter to install with` block in the source.
# Hoisting it here, rather than asking a human to retype it into a second file,
# is what stops the skill and its source from drifting apart.
if [[ -d "$root/src/skills" ]]; then
  cp "$root/src/skills/"*.md "$out/"          # the readable half
  mkdir -p "$out/skills"
  python3 - "$root/src/skills" "$out/skills" <<'PY'
import pathlib, re, sys
src, out = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
emitted = 0
for f in sorted(src.glob("SKILL_*.md")):
    text = f.read_text()
    if f.name == "SKILL_TEMPLATE.md":       # the anatomy, not a skill
        continue
    m = re.search(r'^## Frontmatter to install with\s*\n+```ya?ml\n(.*?)\n```\s*\n',
                  text, re.S | re.M)
    if not m:
        print(f"  !! {f.name}: no '## Frontmatter to install with' block", file=sys.stderr)
        sys.exit(1)
    yaml = re.sub(r'\A-{3,}\s*\n', '', m.group(1).strip())
    yaml = re.sub(r'\n-{3,}\s*\Z', '', yaml).strip()
    name = re.search(r'^name:\s*(\S+)', yaml, re.M)
    if not name:
        print(f"  !! {f.name}: frontmatter has no name:", file=sys.stderr)
        sys.exit(1)
    body = (text[:m.start()] + text[m.end():]).strip()
    # An installed skill sits in .claude/skills/, not next to the docs, so a
    # relative sibling link would dangle. Demote them to plain names rather
    # than invent a path into a tree whose layout we don't control.
    body = re.sub(r'\[`?([A-Za-z0-9_.-]+\.md)`?\]\(\.{0,2}/?[A-Za-z0-9_./-]*\)', r'`\1`', body)
    d = out / name.group(1)
    d.mkdir(parents=True, exist_ok=True)
    (d / "SKILL.md").write_text(f"---\n{yaml}\n---\n\n{body}\n")
    emitted += 1
print(f"  {emitted} skills emitted as installable SKILL.md")
PY
fi

flat=$(find "$out" -maxdepth 1 -name '*.md' | wc -l | tr -d ' ')
cmds=$(find "$out/commands" -name '*.md' | wc -l | tr -d ' ')
echo "built → $out"
echo "  $flat docs (flat) + $cmds commands"
for dir in skills agents scripts config; do
  [[ -d "$out/$dir" ]] || continue
  printf '  %s %s\n' "$(find "$out/$dir" -type f | wc -l | tr -d ' ')" "$dir"
done

[[ $check -eq 0 ]] && exit 0

# --- link check ------------------------------------------------------------
# Every markdown link to a sibling .md must resolve in the flattened layout.
echo
echo "checking cross-links…"

report="$(mktemp)"
trap 'rm -f "$report"' EXIT

while IFS= read -r file; do
  rel="${file#"$out"/}"
  dir="$(dirname "$rel")"
  # Pull ](target.md) / ](./target.md) out of each doc. A doc with no links is
  # not an error, hence `|| true` — grep exits 1 when it matches nothing.
  targets="$(grep -oE '\]\((\./)?[A-Za-z0-9_./-]+\.md(#[A-Za-z0-9_-]+)?\)' "$file" || true)"
  [[ -z "$targets" ]] && continue

  while IFS= read -r target; do
    [[ -z "$target" ]] && continue
    # Links resolve relative to the doc's own directory in the built tree.
    base="$out"
    [[ "$dir" != "." ]] && base="$out/$dir"
    [[ -e "$base/$target" ]] && continue
    printf '  %-38s → %s\n' "$rel" "$target" >> "$report"
  done <<< "$(printf '%s\n' "$targets" | sed -E 's/^\]\(//; s/\)$//; s/#.*$//; s|^\./||')"
done < <(find "$out" -name '*.md')

# The repo's own front page (README / CATALOG / CONTRIBUTING) never ships, so it isn't in
# $out — but its links into src/ still have to resolve, and its anchors have to exist.
# Nothing else checks them, so check them here against the repo itself.
python3 - "$root" >> "$report" <<'PY'
import pathlib, re, sys, unicodedata
root = pathlib.Path(sys.argv[1])

def slug(t):
    t = t.strip().lower()
    keep = ''.join(c for c in t
                   if c in '- ' or unicodedata.category(c)[0] in 'LNM'
                   or unicodedata.category(c) == 'Pc')
    return keep.replace(' ', '-')

for name in ("README.md", "CATALOG.md", "CONTRIBUTING.md"):
    f = root / name
    if not f.exists():
        continue
    text = f.read_text()
    body = re.sub(r'```.*?```', '', text, flags=re.S)   # ignore fenced code
    for target in re.findall(r'\]\(([^)#\s]*)(#[^)\s]*)?\)', body):
        path, frag = target[0], (target[1] or '').lstrip('#')
        if path.startswith(('http://', 'https://', 'mailto:')):
            continue
        dest = (root / path) if path else f
        if path and not dest.exists():
            print(f"  {name:<38} → {path}")
            continue
        if frag:                                        # verify the anchor really exists
            dtext = re.sub(r'```.*?```', '', dest.read_text(), flags=re.S)
            heads = {slug(m.group(1)) for m in re.finditer(r'^#{1,6}\s+(.*)$', dtext, re.M)}
            if frag not in heads:
                print(f"  {name:<38} → {path or dest.name}#{frag}  (no such anchor)")
PY

echo
if [[ -s "$report" ]]; then
  sort -u "$report"
  echo
  echo "$(sort -u "$report" | wc -l | tr -d ' ') broken cross-link(s)"
  exit 1
fi
echo "all cross-links resolve"
