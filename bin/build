#!/usr/bin/env bash
#
# Flatten the src/ tree into the layout consumer repos vendor.
#
#   src/managers/MANAGER_X.md  ───▶  <out>/MANAGER_X.md      (prefix kept)
#   src/skills/SKILL_X.md      ───▶  <out>/SKILL_X.md        (prefix kept)
#   src/runbooks/RUNBOOK_X.md  ───▶  <out>/X.md              (prefix STRIPPED)
#   src/meta/PLACEHOLDERS.md   ───▶  <out>/PLACEHOLDERS.md
#   README.md                  ───▶  <out>/README.md
#   src/commands/foo.md        ───▶  <out>/commands/foo.md
#
# The flat output is the contract, and the naming is asymmetric on purpose: a
# runbook is the doc your team lives with, so it deploys under the name it will
# be called by (`E2E.md`); a manager and a skill are library tooling and keep
# the prefix that says so.
#
# THEREFORE: cross-reference a runbook by its DEPLOYED name (`./E2E.md`) and a
# manager or skill by its LIBRARY name (`./MANAGER_PERFORMANCE.md`). That is the
# single link convention, and `--check` fails the build on anything else.
#
# Usage:
#   bin/build                       # build into dist/
#   bin/build --out ../app/docs/ai-product-builder
#   bin/build --check               # build, then verify cross-links resolve
#
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out="$root/dist"
check=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --out)   out="$2"; shift 2 ;;
    --check) check=1; shift ;;
    -h|--help) sed -n '2,18p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

# Resolve --out to an absolute path before we start deleting anything.
mkdir -p "$out"
out="$(cd "$out" && pwd)"

if [[ "$out" == "$root" ]]; then
  echo "refusing to build into the repo root" >&2
  exit 1
fi

# --- deployed-name mapping -------------------------------------------------
# A RUNBOOK is a *template you fill*, so the prefix is a shipping-crate label:
# it names the crate, not the thing inside. It is stripped on deploy —
# RUNBOOK_METRICS.md ships as METRICS.md — which is what consumer repos
# actually do by hand, and what the docs' own cross-links already assume.
#
# A MANAGER is a *playbook you run*. It keeps its prefix: it stays recognisably
# a library artifact rather than a doc the repo owns, and dropping it would
# collide with the RUNBOOK of the same name (MANAGER_DECISION_LOG /
# RUNBOOK_DECISION_LOG both want DECISION_LOG.md).
deployed_name() {
  case "$1" in
    RUNBOOK_*) echo "${1#RUNBOOK_}" ;;
    *)         echo "$1" ;;
  esac
}

# --- collision guard -------------------------------------------------------
# Flattening several dirs into one is only safe while *deployed* names are
# unique — so this must run on the post-strip names, not the source ones.
dupes="$(for f in "$root/src/managers/"*.md "$root/src/runbooks/"*.md "$root/src/meta/"*.md; do
           deployed_name "$(basename "$f")"
         done | sort | uniq -d)"
if [[ -n "$dupes" ]]; then
  echo "deployed-name collision — these resolve to the same output file:" >&2
  echo "$dupes" >&2
  exit 1
fi

# --- build -----------------------------------------------------------------
rm -rf "$out"
mkdir -p "$out/commands"

for dir in managers runbooks meta; do
  for f in "$root/src/$dir/"*.md; do
    cp "$f" "$out/$(deployed_name "$(basename "$f")")"
  done
done
cp "$root/src/commands/"*.md "$out/commands/"

# README / CATALOG / CONTRIBUTING are about *this repo* — they link into src/, which does not
# exist downstream. A consumer's docs/ gets the library, not our front page.

# Layers that install into .claude/ rather than docs/ — copied through verbatim.
for dir in agents scripts config; do
  [[ -d "$root/src/$dir" ]] || continue
  mkdir -p "$out/$dir"
  cp -R "$root/src/$dir/." "$out/$dir/"
done

# --- skills: one source, two outputs -----------------------------------------
# A skill source is both a doc a human can read and an artifact the agent can
# fire. So it ships twice:
#
#   OUT/SKILL_X.md              flat, alongside the other docs — sibling links resolve
#   OUT/skills/<name>/SKILL.md  drop into .claude/skills/ — frontmatter hoisted
#
# The YAML lives in a `## Frontmatter to install with` block in the source.
# Hoisting it here, rather than asking a human to retype it into a second file,
# is what stops the skill and its source from drifting apart.
if [[ -d "$root/src/skills" ]]; then
  cp "$root/src/skills/"*.md "$out/"          # the readable half
  mkdir -p "$out/skills"
  python3 - "$root/src/skills" "$out/skills" <<'PY'
import pathlib, re, sys
src, out = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
emitted = 0
for f in sorted(src.glob("SKILL_*.md")):
    text = f.read_text()
    if f.name == "SKILL_TEMPLATE.md":       # the anatomy, not a skill
        continue
    m = re.search(r'^## Frontmatter to install with\s*\n+```ya?ml\n(.*?)\n```\s*\n',
                  text, re.S | re.M)
    if not m:
        print(f"  !! {f.name}: no '## Frontmatter to install with' block", file=sys.stderr)
        sys.exit(1)
    yaml = re.sub(r'\A-{3,}\s*\n', '', m.group(1).strip())
    yaml = re.sub(r'\n-{3,}\s*\Z', '', yaml).strip()
    name = re.search(r'^name:\s*(\S+)', yaml, re.M)
    if not name:
        print(f"  !! {f.name}: frontmatter has no name:", file=sys.stderr)
        sys.exit(1)
    body = (text[:m.start()] + text[m.end():]).strip()
    # An installed skill sits in .claude/skills/, not next to the docs, so a
    # relative sibling link would dangle. Demote them to plain names rather
    # than invent a path into a tree whose layout we don't control.
    body = re.sub(r'\[`?([A-Za-z0-9_.-]+\.md)`?\]\(\.{0,2}/?[A-Za-z0-9_./-]*\)', r'`\1`', body)
    d = out / name.group(1)
    d.mkdir(parents=True, exist_ok=True)
    (d / "SKILL.md").write_text(f"---\n{yaml}\n---\n\n{body}\n")
    emitted += 1
print(f"  {emitted} skills emitted as installable SKILL.md")
PY
fi

flat=$(find "$out" -maxdepth 1 -name '*.md' | wc -l | tr -d ' ')
cmds=$(find "$out/commands" -name '*.md' | wc -l | tr -d ' ')
echo "built → $out"
echo "  $flat docs (flat) + $cmds commands"
for dir in skills agents scripts config; do
  [[ -d "$out/$dir" ]] || continue
  printf '  %s %s\n' "$(find "$out/$dir" -type f | wc -l | tr -d ' ')" "$dir"
done

[[ $check -eq 0 ]] && exit 0

# --- link check ------------------------------------------------------------
# Every markdown link to a sibling .md must resolve in the flattened layout.
echo
echo "checking cross-links…"

report="$(mktemp)"
trap 'rm -f "$report"' EXIT

while IFS= read -r file; do
  rel="${file#"$out"/}"
  dir="$(dirname "$rel")"
  # Pull ](target.md) / ](./target.md) out of each doc. A doc with no links is
  # not an error, hence `|| true` — grep exits 1 when it matches nothing.
  targets="$(grep -oE '\]\((\./)?[A-Za-z0-9_./-]+\.md(#[A-Za-z0-9_-]+)?\)' "$file" || true)"
  [[ -z "$targets" ]] && continue

  while IFS= read -r target; do
    [[ -z "$target" ]] && continue
    # Links resolve relative to the doc's own directory in the built tree.
    base="$out"
    [[ "$dir" != "." ]] && base="$out/$dir"
    [[ -e "$base/$target" ]] && continue
    printf '  %-38s → %s\n' "$rel" "$target" >> "$report"
  done <<< "$(printf '%s\n' "$targets" | sed -E 's/^\]\(//; s/\)$//; s/#.*$//; s|^\./||')"
done < <(find "$out" -name '*.md')

# The repo's own front page (README / CATALOG / CONTRIBUTING) never ships, so it isn't in
# $out — but its links into src/ still have to resolve, and its anchors have to exist.
# Nothing else checks them, so check them here against the repo itself.
python3 - "$root" >> "$report" <<'PY'
import pathlib, re, sys, unicodedata
root = pathlib.Path(sys.argv[1])

def slug(t):
    t = t.strip().lower()
    keep = ''.join(c for c in t
                   if c in '- ' or unicodedata.category(c)[0] in 'LNM'
                   or unicodedata.category(c) == 'Pc')
    return keep.replace(' ', '-')

for name in ("README.md", "CATALOG.md", "CONTRIBUTING.md"):
    f = root / name
    if not f.exists():
        continue
    text = f.read_text()
    body = re.sub(r'```.*?```', '', text, flags=re.S)   # ignore fenced code
    for target in re.findall(r'\]\(([^)#\s]*)(#[^)\s]*)?\)', body):
        path, frag = target[0], (target[1] or '').lstrip('#')
        if path.startswith(('http://', 'https://', 'mailto:')):
            continue
        dest = (root / path) if path else f
        if path and not dest.exists():
            print(f"  {name:<38} → {path}")
            continue
        if frag:                                        # verify the anchor really exists
            dtext = re.sub(r'```.*?```', '', dest.read_text(), flags=re.S)
            heads = {slug(m.group(1)) for m in re.finditer(r'^#{1,6}\s+(.*)$', dtext, re.M)}
            if frag not in heads:
                print(f"  {name:<38} → {path or dest.name}#{frag}  (no such anchor)")
PY

# --- portfolio-lessons v0.3.0 checks --------------------------------------
# Three lints added from the portfolio audit of 24 repos:
#   A) every «TOKEN» in src/ is declared in src/meta/PLACEHOLDERS.md
#      (was the 41-unregistered-in-commands debt row in CONTRIBUTING's quality bar)
#   B) every SKILL_*.md carries `**Last reviewed:** «…»` (skill sprawl guard —
#      when a repo has 30+ skills without dates, half of them are dead — see
#      SKILL_TEMPLATE.md §5 "the skill that rots")
#   C) no emoji in any heading (the GitHub slugger strips the emoji but keeps
#      the space after it, so `## 🚀 Setup` → `#-setup` and every hand-written
#      link to it 404s — see CONTRIBUTING.md §Conventions)
#
# Consumer-repo checks (Node version consistency across .nvmrc / package.json
# engines / CI, `.env.example` vs code drift) are the consumer's `bin/lint`
# job — the LIBRARY has no .nvmrc or .env.example. Those live in the runbooks
# they codify (RUNBOOK_ENV_EXAMPLE_TEMPLATE, RUNBOOK_LANDING_SITE_TEMPLATE).
warn_report="$(mktemp)"
trap 'rm -f "$report" "$warn_report"' EXIT

python3 - "$root" "$warn_report" >> "$report" <<'PY'
import pathlib, re, sys

root = pathlib.Path(sys.argv[1])
warn_path = pathlib.Path(sys.argv[2])
warn_lines = []
src = root / "src"
# The LIBRARY is src/{managers,runbooks,commands,skills,agents,scripts,config,meta}.
# src/website is an application that happens to live here — it carries its own
# gates (pnpm ci:quality) and, more to the point, a node_modules of several
# thousand third-party READMEs and CHANGELOGs. Walking those made this linter
# report emoji-in-heading violations from typescript-eslint's release notes.
LIBRARY_LAYERS = ("managers", "runbooks", "commands", "skills", "agents", "scripts", "config", "meta")

def library_docs(src):
    for layer in LIBRARY_LAYERS:
        yield from sorted((src / layer).rglob("*.md"))


# Kebab-case / lowercase tokens are inline-fill; only SCREAMING_SNAKE persists.
# But we also allow SCREAMING_SNAKE:kebab-case sub-keys.
TOKEN_RE = re.compile(r'«([A-Z][A-Z0-9_]*)(:[A-Za-z0-9_\-]+)?»')

# --- A) unregistered tokens ---
# Two-tier: PLACEHOLDERS.md declares CORE (repo-wide, canonical) tokens; each
# layer doc's own Reuse-block "Local definitions to provide per repo" list
# declares PER-DOC tokens (fine for that doc, not required to be canonical).
placeholders = (src / "meta" / "PLACEHOLDERS.md").read_text()
core = set()
for m in TOKEN_RE.finditer(placeholders):
    core.add(m.group(1))
# Sub-keys via the `«QUALITY_CMD:format|lint|…»` alternation shapes
for m in re.finditer(r'«([A-Z][A-Z0-9_]*):([a-zA-Z0-9_|\-]+)»', placeholders):
    for sub in m.group(2).split('|'):
        core.add(f'{m.group(1)}:{sub.strip()}')

def local_declarations(text):
    # Extract tokens declared in the doc's own Reuse-block "Local definitions"
    # section. The section runs from the "Local definitions" line to the first
    # non-blockquote line (i.e. the end of the Reuse block).
    m = re.search(
        r'(?:Local definitions to provide per (?:repo|milestone|invocation)|Local definitions)[^\n]*\n'
        r'((?:>\s*.*\n)+)',
        text)
    if not m:
        return set()
    declared = set()
    for m2 in TOKEN_RE.finditer(m.group(1)):
        declared.add(m2.group(1))
        if m2.group(2):
            declared.add(f'{m2.group(1)}{m2.group(2)}')
    return declared

def is_ok(root_token, sub, local):
    if root_token in core or root_token in local:
        return True
    if sub and (f'{root_token}{sub}' in core or f'{root_token}{sub}' in local):
        return True
    if root_token == 'QUALITY_CMD':   # any sub-key is OK; the root is canonical
        return True
    return False

offenders = {}   # {token: [file:line, ...]}
for f in library_docs(src):
    if f.name == "PLACEHOLDERS.md":
        continue
    text = f.read_text()
    local = local_declarations(text)
    # Strip fenced code blocks so grep patterns inside `«PATTERN»` bash
    # snippets don't get flagged as unregistered token uses.
    stripped = re.sub(r'```.*?```', '', text, flags=re.S)
    for lineno, line in enumerate(stripped.splitlines(), 1):
        for m in TOKEN_RE.finditer(line):
            rt, sub = m.group(1), m.group(2) or ''
            key = f'{rt}{sub}'
            if is_ok(rt, sub, local):
                continue
            offenders.setdefault(key, []).append(f"{f.relative_to(root)}:{lineno}")

if offenders:
    # Unregistered tokens are WARN, not FAIL: 390 pre-existing per-doc tokens
    # (declared inline in each doc's own Reuse block by convention that predates
    # the check) would otherwise break every PR. The list surfaces the debt.
    warn_lines.append(f"  unregistered tokens ({len(offenders)} distinct):")
    for tok, hits in sorted(offenders.items()):
        preview = ', '.join(hits[:3])
        more = f' (+{len(hits)-3} more)' if len(hits) > 3 else ''
        warn_lines.append(f"    «{tok}»  {preview}{more}")

# --- D) one branch model, library-wide --- (FAIL)
# The library documents scope/vX.Y.Z → release/vX.Y.Z → «TRUNK». RUNBOOK_TEAM_PLAYBOOK
# used to ship a rival model — a MAIN_BRANCH / FEATURE_BRANCH_PATTERN pair describing
# feature branches merged straight to main, i.e. GitHub Flow — declared in neither
# PLACEHOLDERS.md nor NAMING_CONVENTIONS.md. A repo set up from that playbook and one
# set up from RELEASE_MANAGER ended up on two different models. Nothing caught it,
# because a contradiction between two documents is invisible to a per-document check.
RIVAL_BRANCH = re.compile(
    r'«(MAIN_BRANCH|FEATURE_BRANCH_PATTERN|DEVELOP_BRANCH)»'
    r'|feature branches \(merge to (?:main|trunk)'
    r'|git.?flow',
    re.I)
for f in library_docs(src):
    stripped = re.sub(r'```.*?```', '', f.read_text(), flags=re.S)
    for lineno, line in enumerate(stripped.splitlines(), 1):
        m = RIVAL_BRANCH.search(line)
        if m:
            print(f"  {f.relative_to(root)}:{lineno}: describes a branch model other than "
                  f"scope/ → release/ → trunk ({m.group(0)!r}) — defer to NAMING_CONVENTIONS.md §1")

# --- E) every layer doc carries a Reuse block --- (FAIL)
# CONTRIBUTING §Conventions: "Every layer doc carries a 🔧 Reuse & local setup block."
for f in library_docs(src):
    if 'TEMPLATE' in f.name.upper() or f.name == 'README.md':
        continue
    if 'Reuse & local setup' not in f.read_text():
        print(f"  {f.relative_to(root)}: no `🔧 Reuse & local setup` block (CONTRIBUTING §Conventions)")

# --- F) boundary discipline --- (WARN — a ratchet, not a gate)
# CONTRIBUTING requires every layer doc to declare what it owns and defers to. All 25
# MANAGERs do; at the time this check landed, 0 of 77 RUNBOOKs did. Making it blocking
# would fail every PR, so it reports a count that must only go down.
_no_owns = [f for f in library_docs(src)
            if 'Owns / defers to' not in f.read_text() and 'TEMPLATE' not in f.name.upper()]
if _no_owns:
    warn_lines.append(f"  no `Owns / defers to` boundary ({len(_no_owns)} docs — ratchet down, never up):")
    from collections import Counter as _C
    for _layer, _n in sorted(_C(f.relative_to(src).parts[0] for f in _no_owns).items()):
        warn_lines.append(f"    {_layer}: {_n}")

# --- B) SKILL `**Last reviewed:**` presence --- (FAIL — small number, easy to fix)
for f in sorted((src / "skills").glob("SKILL_*.md")):
    if f.name == "SKILL_TEMPLATE.md":
        continue   # the template itself
    if "**Last reviewed:**" not in f.read_text():
        print(f"  {f.relative_to(root)}: missing `**Last reviewed:**` line (see SKILL_TEMPLATE.md §5 sibling anti-pattern)")

# --- C) no emoji in headings --- (WARN — pre-existing occurrences exist)
# Ignore fenced code blocks — `# ❌ Runbook line` inside a ```bash fence is
# a comment, not a heading. Emoji ranges cover what the GitHub slugger drops.
EMOJI_RE = re.compile(
    r'['
    r'\U0001F300-\U0001F9FF'   # symbols & pictographs, emoticons, transport, misc
    r'\U0001FA00-\U0001FAFF'   # extended symbols
    r'☀-➿'           # misc symbols + dingbats (☀ ✓ ✅ ❌ etc.)
    r'⌀-⏿'           # misc technical (⌘ ⏰ etc.)
    r']'
)
for f in library_docs(src):
    text = f.read_text()
    stripped = re.sub(r'```.*?```', '', text, flags=re.S)
    for lineno, line in enumerate(stripped.splitlines(), 1):
        if re.match(r'^#{1,6}\s', line) and EMOJI_RE.search(line):
            warn_lines.append(f"  {f.relative_to(root)}:{lineno}: emoji in heading breaks anchor slugger ({line.strip()[:60]})")

if warn_lines:
    warn_path.write_text('\n'.join(warn_lines) + '\n')
PY

echo

if [[ -s "$warn_report" ]]; then
  echo "warnings (pre-existing debt — not blocking):"
  sort -u "$warn_report"
  echo
fi

if [[ -s "$report" ]]; then
  sort -u "$report"
  echo
  echo "$(sort -u "$report" | wc -l | tr -d ' ') blocking issue(s) — broken cross-links, missing SKILL review dates, or hard structural problems"
  exit 1
fi
echo "all cross-links resolve · all SKILL reviewed dates present"
